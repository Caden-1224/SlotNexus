# 构建目录（按平台命名，不提交）
build-*/

# CMake / 编译生成物
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
*.o
*.a
*.so
*.so.*

# 模型、厂商 SDK 与第三方源码（只保留 README 说明与已打包的 MIT 单头文件）
models/*
!models/README.md
third_party/*
!third_party/README.md
!third_party/nlohmann/
!third_party/nlohmann/json.hpp
*.rkllm
*.rknn
*.onnx
*.img

# 音频与日志证据可能含隐私，只允许通过 artifacts 白名单方式提交
*.wav
*.pcm
*.raw
# 固定输入 fixture 例外：确定性生成、无隐私（生成方法见
# scripts/gen_fixture_wav.py 与 README 的 data/fixtures 说明）
!data/fixtures/voice.wav

# 编辑器与临时文件
.vscode/
.idea/
*.swp
*.tmp

# CTest 运行目录
Testing/
