{
  "router": {
    "l0_keywords": ["停止", "取消", "暂停", "闭嘴", "stop", "cancel", "quit"],
    "direct_threshold": 4.5,
    "context_threshold": 2.0,
    "top_k": 2
  },
  "knowledge": "data/knowledge/knowledge.jsonl",
  "queues": {
    "text_capacity": 8,
    "pcm_capacity": 32,
    "push_timeout_ms": 50
  },
  "output_dir": "session-out",
  "stage_delay_ms": 0,
  "text_chunk_max_bytes": 60,
  "asr": {
    "backend": "sherpa_onnx",
    "model": "models/sherpa-zipformer-bilingual-zh-en-2023-02-16",
    "model_precision": "fp32",
    "num_threads": 4
  },
  "llm": {
    "backend": "rkllm",
    "model": "models/Qwen3.5-0.8B_w4a16_g128_rk3576.rkllm",
    "max_new_tokens": 256,
    "max_context_len": 4096,
    "top_k": 1,
    "top_p": 0.95,
    "temperature": 0.8,
    "repeat_penalty": 1.1,
    "frequency_penalty": 0.0,
    "presence_penalty": 0.0,
    "skip_special_token": true,
    "ignore_eos_token": false,
    "enable_thinking": false,
    "reasoning_end_tag": "",
    "enabled_cpus_num": 4,
    "enabled_cpus_mask": 240,
    "embed_flash": true,
    "base_domain_id": 0
  },
  "tts": {
    "backend": "melotts",
    "encoder_model": "models/melotts/encoder-zh.onnx",
    "decoder_model": "models/melotts/decoder-zh.rknn",
    "lexicon": "models/melotts/lexicon.txt",
    "tokens": "models/melotts/tokens.txt",
    "g_vector": "models/melotts/g-zh_mix_en.bin",
    "native_sample_rate": 44100,
    "speed": 0.8,
    "noise_scale": 0.3,
    "noise_scale_w": 0.6,
    "sdp_ratio": 0.2,
    "intra_op_threads": 1,
    "max_encoder_phones": 240,
    "run_timeout_ms": 30000
  },
  "tts_min_duration_ms": 1000,
  "max_run_ms": 180000
}
