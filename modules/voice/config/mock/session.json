{
  "router": {
    "l0_keywords": ["停止", "取消", "暂停", "闭嘴", "stop", "cancel", "quit"],
    "direct_threshold": 4.5,
    "context_threshold": 2.0,
    "top_k": 2
  },
  "knowledge": "data/knowledge/knowledge.jsonl",
  "queues": {
    "text_capacity": 8,
    "pcm_capacity": 32,
    "push_timeout_ms": 50
  },
  "stream": {
    "pre_roll_ms": 500,
    "min_speech_ms": 60,
    "min_silence_ms": 500,
    "speech_rms_threshold": 100
  },
  "output_dir": "session-out",
  "stage_delay_ms": 0,
  "text_chunk_max_bytes": 60,
  "tts_min_duration_ms": 1000,
  "max_run_ms": 30000,
  "continuous": {
    "enabled": false,
    "sleep_words": ["退下"],
    "follow_up_timeout_ms": 60000,
    "max_session_ms": 300000,
    "max_turns": 6
  }
}
